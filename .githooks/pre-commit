#!/usr/bin/env bash
set -euo pipefail

# added-lines ceiling
added_total=0
while IFS=$'\t' read -r added deleted path; do
  [ "$added" = "-" ] && continue
  added_total=$((added_total + added))
done < <(git diff --cached --numstat)

if [ "$added_total" -gt 500 ]; then
  echo "pre-commit: $added_total added lines exceeds the 300-500 ceiling." >&2
  exit 1
fi

exit 0
